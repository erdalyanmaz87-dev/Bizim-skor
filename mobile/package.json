{
  "name": "bizimskor-mobile",
  "version": "1.0.2",
  "description": "BizimSkor Android uygulaması",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "test": "npm run build:web && node --test test/*.test.mjs",
    "sync:android": "npm run build:web && cap sync android",
    "build:debug": "npm run sync:android && cd android && ./gradlew assembleDebug",
    "build:release": "npm run sync:android && cd android && ./gradlew bundleRelease"
  },
